<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_card_declaration"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/box_with_two_margins"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/card_declaration_ly_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="10dp"
            android:paddingHorizontal="30dp"
            android:background="@drawable/box_with_margins_bg">
            <TextView
                android:id="@+id/card_declaration_tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MARZO"
                android:textAlignment="center"
                style="@style/text_style"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/card_declaration_iv_triangle"
                android:rotation="90"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/triangle"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_declaration_ly_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="10dp"
            android:paddingHorizontal="30dp">
            <LinearLayout
                android:id="@+id/card_declaration_ly_intermediary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/card_declaration_tv_intermediary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_declaration_text_intermediary"
                    style="@style/text_style"
                    android:layout_weight="2"/>
                <TextView
                    android:id="@+id/card_declaration_tv_intermediary_value"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="$ 1000"
                    style="@style/text_style"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/card_declaration_ly_cash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/card_declaration_tv_cash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_declaration_text_cash"
                    style="@style/text_style"
                    android:layout_weight="2"/>
                <TextView
                    android:id="@+id/card_declaration_tv_cash_value"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="$ 889"
                    style="@style/text_style"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/card_declaration_ly_isr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/card_declaration_tv_isr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_declaration_text_isr"
                    style="@style/text_style"
                    android:layout_weight="2"/>
                <TextView
                    android:id="@+id/card_declaration_tv_isr_value"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="$ 50"
                    style="@style/text_style"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/card_declaration_ly_total_sat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/card_declaration_tv_total_sat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_declaration_text_total_sat"
                    style="@style/text_style"
                    android:layout_weight="2"/>
                <TextView
                    android:id="@+id/card_declaration_tv_total_sat_value"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="$ 50"
                    style="@style/text_style"
                    android:textColor="@color/red"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/card_declaration_ly_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/card_declaration_tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_declaration_text_status"
                    style="@style/text_style"
                    android:layout_weight="2"/>
                <CheckBox
                    android:id="@+id/card_declaration_tv_status_value"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:text="Pagado"
                    android:checked="true"
                    style="@style/checkbox_button_bg"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/card_declaration_ly_delete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="left">
                <ImageView
                    android:id="@+id/card_declaration_iv_delete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/trash_can"
                    android:layout_gravity="center"/>
                <TextView
                    android:id="@+id/card_declaration_tv_delete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_declaration_delete_text"
                    style="@style/text_style"
                    android:textColor="@color/red"
                    android:layout_gravity="center"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>



</androidx.cardview.widget.CardView>