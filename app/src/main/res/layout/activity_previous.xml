<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/previous_activity_scroll"
    style="@style/menu_bg"
    tools:context=".PreviousActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_previous"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            style="@style/toolbar_bg"
            android:title="@string/app_name"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:id="@+id/previous_activity_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/previous_activity_title"
            style="@style/text_title"
            android:layout_marginTop="100dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/previous_activity_ly_total"/>
        <LinearLayout
            android:id="@+id/previous_activity_ly_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="5dp"
            android:layout_marginHorizontal="30dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/previous_activity_title"
            app:layout_constraintBottom_toTopOf="@+id/previous_activity_ly_data">
                <TextView
                    android:id="@+id/previous_activity_tv_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/previous_activity_total_text"
                    style="@style/text_style"
                    android:textSize="20sp"
                    android:layout_weight="3"/>
                <TextView
                    android:id="@+id/previous_activity_tv_total_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$ 1,889"
                    style="@style/text_style"
                    android:textSize="20sp"
                    android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/previous_activity_ly_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/previous_activity_ly_total"
            app:layout_constraintBottom_toTopOf="@+id/previous_activity_cb_payment">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="30dp"
                    android:background="@drawable/box_with_margins_bg">
                        <TextView
                            android:id="@+id/previous_activity_tv_month_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/previous_activity_text_month"
                            style="@style/text_style"
                            android:textSize="20sp"
                            android:layout_weight="1"/>
                        <TextView
                            android:id="@+id/previous_activity_tv_month_value"
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:text="Marzo"
                            style="@style/text_style"
                            android:textSize="20sp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="30dp"
                    android:background="@drawable/box_with_margins_bg"
                    android:layout_marginTop="2dp">
                        <TextView
                            android:id="@+id/previous_activity_tv_status_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/previous_activity_text_status"
                            style="@style/text_style"
                            android:textSize="20sp"
                            android:layout_weight="1"/>
                        <TextView
                            android:id="@+id/previous_activity_tv_status_value"
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:text="Pendiente"
                            style="@style/text_style"
                            android:textSize="20sp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="30dp"
                    android:background="@drawable/box_with_margins_bg"
                    android:layout_marginTop="2dp">
                        <TextView
                            android:id="@+id/previous_activity_tv_cash_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/previous_activity_text_cash"
                            style="@style/text_style"
                            android:textSize="20sp"
                            android:layout_weight="1"/>
                        <TextView
                            android:id="@+id/previous_activity_tv_cash_value"
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:text="$ 889"
                            style="@style/text_style"
                            android:textSize="20sp"
                            android:textColor="@color/red"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="30dp"
                    android:background="@drawable/box_with_margins_bg"
                    android:layout_marginTop="2dp">
                        <TextView
                            android:id="@+id/previous_activity_tv_isr_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/previous_activity_text_isr"
                            style="@style/text_style"
                            android:textSize="20sp"
                            android:layout_weight="1"/>
                        <TextView
                            android:id="@+id/previous_activity_tv_isr_value"
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:text="$ 59"
                            style="@style/text_style"
                            android:textSize="20sp"
                            android:textColor="@color/red"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="30dp"
                    android:background="@drawable/box_with_margins_bg"
                    android:layout_marginTop="2dp">
                        <TextView
                            android:id="@+id/previous_activity_tv_intermediary_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/previous_activity_text_intermediary"
                            style="@style/text_style"
                            android:textSize="20sp"
                            android:layout_weight="1"/>
                        <TextView
                            android:id="@+id/previous_activity_tv_intermediary_value"
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:text="$ 1000"
                            style="@style/text_style"
                            android:textSize="20sp"
                            android:textColor="@color/red"/>
                </LinearLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/previous_activity_total_sat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/previous_activity_text_total_sat"
            style="@style/text_style"
            android:textSize="15sp"
            android:textAlignment="center"
            android:layout_marginTop="20dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/previous_activity_ly_data"/>
        <CheckBox
            android:id="@+id/previous_activity_cb_payment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/previous_activity_payment_text"
            style="@style/checkbox_button_bg"
            android:checked="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/previous_activity_total_sat"
            app:layout_constraintBottom_toTopOf="@+id/previous_activity_btn_save"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/previous_activity_btn_save"
            android:layout_width="250dp"
            android:layout_height="60dp"
            style="@style/button_bg"
            android:text="@string/previous_activity_btn_save"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="100dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/previous_activity_cb_payment"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>