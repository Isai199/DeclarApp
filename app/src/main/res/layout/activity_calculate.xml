<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/menu_bg"
    tools:context=".CalculateActivity">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_calculate"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            style="@style/toolbar_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="10dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:id="@+id/calculate_activity_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calculate_activity_title"
                style="@style/text_title"
                android:layout_marginTop="100dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/calculate_activity_spinner_weekends"
                app:layout_constraintTop_toTopOf="parent"/>
            <Spinner
                android:id="@+id/calculate_activity_spinner_weekends"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:textAlignment="center"
                android:layout_marginTop="10dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/calculate_activity_title"
                app:layout_constraintBottom_toTopOf="@+id/calculate_activity_ly_wekends"/>
            <LinearLayout
                android:id="@+id/calculate_activity_ly_wekends"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/calculate_activity_spinner_weekends"
                app:layout_constraintBottom_toTopOf="@+id/calculate_activity_textarea_tile">
                    <LinearLayout
                        android:id="@+id/calculate_activity_ly_first_week"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                            <TextView
                                android:id="@+id/calculate_activity_tv_first_week"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="@string/calculate_activity_first_week"
                                style="@style/text_style"
                                android:textSize="20sp"
                                android:layout_weight="2"/>
                            <EditText
                                android:id="@+id/calculate_activity_et_first_week"
                                android:layout_width="50dp"
                                android:layout_height="wrap_content"
                                android:text="$ 858"
                                style="@style/text_style"
                                android:layout_weight="1"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/calculate_activity_ly_second_week"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                            <TextView
                                android:id="@+id/calculate_activity_tv_second_week"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="@string/calculate_activity_second_week"
                                style="@style/text_style"
                                android:textSize="20sp"
                                android:layout_weight="2"/>
                            <EditText
                                android:id="@+id/calculate_activity_et_second_week"
                                android:layout_width="50dp"
                                android:layout_height="wrap_content"
                                android:text="$ 858"
                                style="@style/text_style"
                                android:layout_weight="1"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/calculate_activity_ly_third_week"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                            <TextView
                                android:id="@+id/calculate_activity_tv_third_week"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="@string/calculate_activity_third_week"
                                style="@style/text_style"
                                android:textSize="20sp"
                                android:layout_weight="2"/>
                            <EditText
                                android:id="@+id/calculate_activity_et_third_week"
                                android:layout_width="50dp"
                                android:layout_height="wrap_content"
                                android:text="$ 858"
                                style="@style/text_style"
                                android:layout_weight="1"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/calculate_activity_ly_fourth_week"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                                android:id="@+id/calculate_activity_tv_fourth_week"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="@string/calculate_activity_fourth_week"
                                style="@style/text_style"
                                android:textSize="20sp"
                                android:layout_weight="2"/>
                        <EditText
                                android:id="@+id/calculate_activity_et_fourth_week"
                                android:layout_width="50dp"
                                android:layout_height="wrap_content"
                                android:text="$ 858"
                                style="@style/text_style"
                                android:layout_weight="1"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/calculate_activity_ly_fifth_week"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/calculate_activity_tv_fifth_week"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="@string/calculate_activity_fifth_week"
                            style="@style/text_style"
                            android:textSize="20sp"
                            android:layout_weight="2"/>
                        <EditText
                            android:id="@+id/calculate_activity_et_fifth_week"
                            android:layout_width="50dp"
                            android:layout_height="wrap_content"
                            android:text="$ 858"
                            style="@style/text_style"
                            android:layout_weight="1"/>
                    </LinearLayout>

            </LinearLayout>
            <TextView
                android:id="@+id/calculate_activity_textarea_tile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/calculate_activity_upload_file_title"
                style="@style/upload_title"
                android:layout_marginTop="10dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/calculate_activity_ly_wekends"
                app:layout_constraintBottom_toTopOf="@+id/calculate_activity_rl_upload_file"/>

            <RelativeLayout
                android:id="@+id/calculate_activity_rl_upload_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="8dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/calculate_activity_textarea_tile">

                <View
                    android:id="@+id/calculate_activity_view_textarea"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:background="@drawable/textarea_bg" />

                <ImageView
                    android:id="@+id/calculate_activity_iv_upload_file"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/plus_circle_outline"
                    android:layout_centerVertical="true"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>

            <TextView
                android:id="@+id/calculate_activity_total_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/calculate_activity_total_text"
                style="@style/text_style"
                android:textSize="15sp"
                android:textAlignment="center"
                android:layout_marginTop="20dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/calculate_activity_rl_upload_file"/>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/calculate_activity_btn_calculate"
                android:layout_width="250dp"
                android:layout_height="60dp"
                style="@style/button_bg"
                android:text="@string/calculate_activity_btn_calculate_text"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="100dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/calculate_activity_total_text"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>